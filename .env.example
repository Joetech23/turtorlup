# ------------------------------------------------------------------
# Tutorlup environment variables
# Copy to .env.local for local development. Never commit real values.
# ------------------------------------------------------------------

# Leave BOTH of these empty to run in demo mode (built-in sample data,
# no database needed). Fill them in to switch to Supabase mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed in Supabase mode for the password-free demo
# workspace, the public API / embed form and `npm run db:seed`.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects /api/cron/reseed (Vercel Cron refreshes the shared
# demo workspace nightly so its dates stay current). Any long random string.
CRON_SECRET=
